# Copy to .env for local development. Never commit a real .env file.
# Example local URI: mongodb://127.0.0.1:27017/pawcare
MONGODB_URI=mongodb://127.0.0.1:27017/pawcare
PAWCARE_JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
API_PORT=3001
CLIENT_ORIGIN=http://localhost:3000
UPLOAD_DIR=server/uploads
MAX_FILE_SIZE_MB=5
# In production, the host supplies PORT (default 3000).
